# Bislig Hub — Environment placeholders
# Copy to .env.local and fill with the Bislig Ride project values.
# Do NOT commit real credentials (.env / .env.local are git-ignored).
# NOTE: key name is VITE_SUPABASE_PUBLISHABLE_KEY (matches Bislig Ride).

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Web Push (driver notifications). Public VAPID key only — safe for the
# browser bundle. NEVER put the VAPID private key in any VITE_* variable,
# source file, or Git history; it lives in Supabase Edge Function secrets.
# Leave empty until keys are provisioned; the driver UI then reports push
# as unconfigured instead of crashing.
VITE_VAPID_PUBLIC_KEY=
